    {
      "id": 2,
      "type": "stat",
      "title": "EU: WER",
      "description": "What the EU stack (Scaleway Whisper) will run once the final transcript ships. Average over the five test sets with text written by people.",
      "datasource": {
        "type": "postgres",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select v as value from (select pipeline, avg(wer_to_reference) * 100 as v, avg(cost_per_hour_eur) as eur from obs.transcription_latest where human_text and pipeline is not null and pipeline = 'Whisper large v3 + GLM merge' group by 1 having count(*) = (select count(distinct dataset) from obs.transcription_latest where human_text)) t",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 13,
          "valueSize": 30
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "no data yet",
