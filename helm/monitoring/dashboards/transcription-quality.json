      "id": 11,
      "type": "table",
      "title": "Real recordings without human text: WER against Gemini's full audio pass",
      "datasource": {
        "type": "postgres",
        "uid": "${ds}"
      },
      "description": "No person wrote these out, so the reference is GCP Gemini Flash 3.8 with the full audio pass. A low number means close to Gemini, not correct, so this table does not compare with the one above.",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select pipeline as \"Pipeline\",\nround((max(wer_to_reference) filter (where dataset_label = 'Our product meetings') * 100)::numeric, 1)::float8 as \"Our product meetings\",\nround((max(wer_to_reference) filter (where dataset_label = 'City sessions, Dutch') * 100)::numeric, 1)::float8 as \"City sessions, Dutch\",\nround((max(wer_to_reference) filter (where dataset_label = 'Tech event, English') * 100)::numeric, 1)::float8 as \"Tech event, English\"\nfrom obs.transcription_latest where not human_text and pipeline in (${pipeline:sqlstring}) and arm <> 'final_gemini' group by pipeline order by 2",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
