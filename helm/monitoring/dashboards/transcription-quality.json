    "dembrane-sam"
  ],
  "schemaVersion": 38,
  "version": 5,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "style": "dark",
  "timezone": "Europe/Amsterdam",
  "weekStart": "monday",
  "refresh": "",
