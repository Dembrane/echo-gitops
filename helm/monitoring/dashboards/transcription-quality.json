    {
      "id": 9,
      "type": "table",
      "title": "WER per test set and price",
      "datasource": {
        "type": "postgres",
        "uid": "${ds}"
      },
      "description": "Read speech: audiobooks in Dutch and English. Read, loud room: the same with background noise. FLEURS: Dutch read sentences. VoxPopuli: Dutch parliament speeches. AMI: English meetings recorded by a microphone on the table. Average counts every test set once.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select pipeline as \"Pipeline\", max(pipeline_note) as \"What it does\",\nround((max(wer_to_reference) filter (where dataset_label = 'Read speech') * 100)::numeric, 1)::float8 as \"Read speech\",\nround((max(wer_to_reference) filter (where dataset_label = 'Read, loud room') * 100)::numeric, 1)::float8 as \"Read, loud room\",\nround((max(wer_to_reference) filter (where dataset_label = 'FLEURS (Dutch)') * 100)::numeric, 1)::float8 as \"FLEURS (Dutch)\",\nround((max(wer_to_reference) filter (where dataset_label = 'VoxPopuli (Dutch)') * 100)::numeric, 1)::float8 as \"VoxPopuli (Dutch)\",\nround((max(wer_to_reference) filter (where dataset_label = 'AMI meetings') * 100)::numeric, 1)::float8 as \"AMI meetings\",\nround((avg(wer_to_reference) * 100)::numeric, 1)::float8 as \"Average\",\nround(avg(cost_per_hour_eur)::numeric, 2)::float8 as \"\u20ac per audio hour\"\nfrom obs.transcription_latest where human_text and pipeline in (${pipeline:sqlstring}) group by stack, pipeline having count(*) = (select count(distinct dataset) from obs.transcription_latest where human_text) order by stack desc, avg(wer_to_reference)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
