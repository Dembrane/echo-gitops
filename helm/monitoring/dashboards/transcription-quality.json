          "rawSql": "select dataset_label as \"Test set\", pipeline as \"Pipeline\", wer_to_reference * 100 as \"WER\"\nfrom obs.transcription_latest where human_text and pipeline in (${pipeline:sqlstring}) order by 1, 2",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
