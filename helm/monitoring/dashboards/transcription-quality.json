    {
      "id": 11,
      "type": "table",
      "title": "No human text here: how far each pipeline lands from Gemini's own reading (not comparable with the table above)",
      "datasource": {
        "type": "postgres",
        "uid": "${ds}"
      },
      "description": "These recordings have no text written by people, so the reference is Gemini reading the whole recording. A low number means close to Gemini, not correct. The city sessions and the tech event were measured with an earlier version of the second listen and cannot be repeated.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select pipeline as \"Pipeline\",\nround((max(wer_to_reference) filter (where dataset_label = 'Our product meetings') * 100)::numeric, 1)::float8 as \"Our product meetings\",\nround((max(wer_to_reference) filter (where dataset_label = 'City sessions, Dutch') * 100)::numeric, 1)::float8 as \"City sessions, Dutch\",\nround((max(wer_to_reference) filter (where dataset_label = 'Tech event, English') * 100)::numeric, 1)::float8 as \"Tech event, English\"\nfrom obs.transcription_latest where not human_text and pipeline is not null and arm <> 'final_gemini' group by pipeline order by 2",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
