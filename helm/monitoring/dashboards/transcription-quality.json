            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select stack as \"Stack\", pipeline as \"Pipeline\",\nround((max(wer_to_reference) filter (where dataset_label = 'Read speech') * 100)::numeric, 1)::float8 as \"Read speech\",\nround((max(wer_to_reference) filter (where dataset_label = 'Read, loud room') * 100)::numeric, 1)::float8 as \"Read, loud room\",\nround((max(wer_to_reference) filter (where dataset_label = 'FLEURS (Dutch)') * 100)::numeric, 1)::float8 as \"FLEURS (Dutch)\",\nround((max(wer_to_reference) filter (where dataset_label = 'VoxPopuli (Dutch)') * 100)::numeric, 1)::float8 as \"VoxPopuli (Dutch)\",\nround((max(wer_to_reference) filter (where dataset_label = 'AMI meetings') * 100)::numeric, 1)::float8 as \"AMI meetings\",\nround((avg(wer_to_reference) * 100)::numeric, 1)::float8 as \"Average\",\nround(avg(cost_per_hour_eur)::numeric, 2)::float8 as \"EUR per audio hour\"\nfrom obs.transcription_latest where human_text and pipeline is not null group by stack, pipeline having count(*) = (select count(distinct dataset) from obs.transcription_latest where human_text) order by stack desc, avg(wer_to_reference)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
