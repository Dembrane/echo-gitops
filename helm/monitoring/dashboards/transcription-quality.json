            "selected": false
          },
          {
            "text": "Whisper v3 large (live only)",
            "value": "Whisper v3 large (live only)",
            "selected": false
          },
          {
            "text": "dembrane-26-10-whisper-eu",
            "value": "dembrane-26-10-whisper-eu",
            "selected": true
          }
        ],
        "current": {
          "text": [
            "dembrane-26-10-whisper-eu",
            "dembrane-26-10-gemini"
          ],
          "value": [
            "dembrane-26-10-whisper-eu",
            "dembrane-26-10-gemini"
          ],
          "selected": true
        }
      },
      {
        "type": "datasource",
        "name": "ds",
        "label": "Environment",
        "query": "postgres",
        "regex": "/^dembrane sam$/",
        "current": {
          "text": "dembrane sam",
          "value": "dembrane sam",
          "selected": true
