    {
      "id": 10,
      "type": "table",
      "title": "Test sets",
      "datasource": {
        "type": "postgres",
        "uid": "${ds}"
      },
      "description": "Public test splits with text written by people. Public means a model may have seen them in training, which can flatter every pipeline alike; it does not change the order.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select dataset_label as \"Test set\", max(recordings) as \"Recordings\", round((sum(audio_seconds) / 3600)::numeric, 1)::float8 / count(distinct arm) as \"Hours\" from obs.transcription_latest where human_text and pipeline in (${pipeline:sqlstring}) group by dataset_label order by 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hours"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
