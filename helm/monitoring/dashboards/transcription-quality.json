      "id": 1,
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Word error rate (WER)**: the share of words a pipeline gets wrong, leaves out or adds, against text written by people. Averaged over five public test sets in Dutch and English. Lower is better."
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "EU stack runs",
      "datasource": null,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**dembrane-26-10-whisper-eu**\n\nWhisper live, then the whole recording again and a GLM clean-up."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WER",
      "description": "Average over the five test sets with text written by people.",
      "datasource": {
        "type": "postgres",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${ds}"
          },
          "rawSql": "select v as value from (select avg(wer_to_reference) * 100 as v, avg(cost_per_hour_eur) as eur from obs.transcription_latest where human_text and pipeline is not null and pipeline = 'dembrane-26-10-whisper-eu' having count(*) = (select count(distinct dataset) from obs.transcription_latest where human_text)) t",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 13,
          "valueSize": 32
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "no data yet",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e0752d"
