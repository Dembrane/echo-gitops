    {"id": 27, "type": "timeseries", "title": "Audio chunks per 5 minutes", "description": "Chunks received, by 5 minute bucket; errors on top. Reads the last 7 days.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 18}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), sum(chunks) as chunks, sum(errors) as errors from obs.minute_chunks where $__timeFilter(minute) group by 1 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 28, "type": "timeseries", "title": "Conversations with audio per 5 minutes", "description": "Distinct conversations that sent audio in each 5 minute bucket: how many people were recording at once.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 18}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), max(conversations) as conversations from obs.minute_chunks where $__timeFilter(minute) group by 1 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 29, "type": "timeseries", "title": "Pipeline step time, average per 5 minutes (s)", "description": "Average duration of each pipeline step (transcribe, split, summarize, merge) in the bucket.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 25}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), replace(replace(event, 'task_', ''), '.completed', '') as metric, sum(avg_ms * n)::double precision / greatest(sum(n), 1) / 1000.0 as value from obs.minute_pipeline where $__timeFilter(minute) and event like '%.completed' group by 1, 2 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 30, "type": "timeseries", "title": "Pipeline failures per 5 minutes", "description": "Failed pipeline steps per bucket, by step.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 25}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), replace(replace(event, 'task_', ''), '.failed', '') as metric, sum(n) as value from obs.minute_pipeline where $__timeFilter(minute) and event like '%.failed' group by 1, 2 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 31, "type": "row", "title": "Last 35 days, per day", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "panels": []},
    {"id": 32, "type": "timeseries", "title": "Conversations and hours per day", "description": "Conversations started and hours recorded, per Amsterdam day, last 35 days.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 33}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select day as time, created as conversations, round((seconds_recorded / 3600.0)::numeric, 1) as hours from obs.day_conversations order by day", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 33, "type": "timeseries", "title": "Reports and chats per day", "description": "Reports requested, chats started and messages, per Amsterdam day, last 35 days.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 33}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(r.day, c.day) as time, coalesce(r.reports, 0) as reports, coalesce(c.chats_created, 0) as chats, coalesce(c.messages, 0) as messages from (select day, sum(n) as reports from obs.day_reports where kind = 'report' group by day) r full outer join obs.day_chats c on c.day = r.day order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 34, "type": "table", "title": "Pipeline steps per day", "description": "Every pipeline step of the last 7 days with its count and timings (ms).", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 9, "w": 24, "x": 0, "y": 40}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select day, replace(event, 'task_', '') as step, n, avg_ms, p50_ms, p95_ms, max_ms from obs.day_pipeline where day >= (now() at time zone 'Europe/Amsterdam')::date - 7 order by day desc, n desc", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}, "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": false}}, "overrides": [{"matcher": {"id": "byName", "options": "avg_ms"}, "properties": [{"id": "unit", "value": "ms"}]}, {"matcher": {"id": "byName", "options": "p50_ms"}, "properties": [{"id": "unit", "value": "ms"}]}, {"matcher": {"id": "byName", "options": "p95_ms"}, "properties": [{"id": "unit", "value": "ms"}]}, {"matcher": {"id": "byName", "options": "max_ms"}, "properties": [{"id": "unit", "value": "ms"}]}]}}
