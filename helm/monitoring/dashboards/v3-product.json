    {"id": 19, "type": "stat", "title": "Messages per active chat", "description": "Messages that day divided by chats that had a message that day.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 20, "y": 9}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round(messages::numeric / greatest(active_chats, 1), 1) as value from obs.day_chats where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round(messages::numeric / greatest(active_chats, 1), 1) as value from obs.day_chats where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "decimals": 1}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 20, "type": "stat", "title": "Assistant runs", "description": "Assistant (agent) runs started that day.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 0, "y": 13}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(runs), 0) as value from obs.day_assistant where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(runs), 0) as value from obs.day_assistant where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 21, "type": "stat", "title": "Assistant runs not completed", "description": "Runs started that day whose status is neither completed nor still running.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 4, "y": 13}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(not_completed), 0) as value from obs.day_assistant where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(not_completed), 0) as value from obs.day_assistant where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
