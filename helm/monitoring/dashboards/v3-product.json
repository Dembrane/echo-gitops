    {"id": 23, "type": "stat", "title": "Transcription p95 (s)", "description": "95 % of chunk transcriptions that day finished within this many seconds (download, model call and save).", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 12, "y": 13}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(max(p95_ms / 1000.0), 0) as value from obs.day_pipeline where day = (now() at time zone 'Europe/Amsterdam')::date and event = 'task_transcribe_chunk.completed'", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(max(p95_ms / 1000.0), 0) as value from obs.day_pipeline where day = ((now() at time zone 'Europe/Amsterdam')::date - 1) and event = 'task_transcribe_chunk.completed'", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "decimals": 1}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 24, "type": "stat", "title": "Transcriptions failed", "description": "Chunk transcriptions that failed that day (a later attempt may have succeeded).", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 16, "y": 13}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(n), 0) as value from obs.day_pipeline where day = (now() at time zone 'Europe/Amsterdam')::date and event = 'task_transcribe_chunk.failed'", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(n), 0) as value from obs.day_pipeline where day = ((now() at time zone 'Europe/Amsterdam')::date - 1) and event = 'task_transcribe_chunk.failed'", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 25, "type": "stat", "title": "Summaries", "description": "Conversation summaries written that day.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 20, "y": 13}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(n), 0) as value from obs.day_pipeline where day = (now() at time zone 'Europe/Amsterdam')::date and event = 'task_summarize_conversation.completed'", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(n), 0) as value from obs.day_pipeline where day = ((now() at time zone 'Europe/Amsterdam')::date - 1) and event = 'task_summarize_conversation.completed'", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
