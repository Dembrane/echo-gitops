{
  "uid": "v3-ai",
  "title": "dembrane v3: AI",
  "description": "How the model calls behave: volume, latency, context size, errors, refusals and an estimated cost, per Amsterdam day and over time. Counts and sizes only, never text.",
  "tags": ["dembrane-v3"],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "style": "dark",
  "timezone": "Europe/Amsterdam",
  "weekStart": "monday",
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "annotations": {"list": []},
  "links": [{"type": "link", "title": "Product", "url": "/d/v3-product", "icon": "dashboard", "keepTime": true, "includeVars": true, "targetBlank": false, "asDropdown": false, "tags": [], "tooltip": ""}, {"type": "link", "title": "Overview", "url": "/d/v3-overview", "icon": "dashboard", "keepTime": true, "includeVars": true, "targetBlank": false, "asDropdown": false, "tags": [], "tooltip": ""}, {"type": "link", "title": "Worker and jobs", "url": "/d/v3-worker-jobs", "icon": "dashboard", "keepTime": true, "includeVars": true, "targetBlank": false, "asDropdown": false, "tags": [], "tooltip": ""}],
  "templating": {"list": [
    {"type": "datasource", "name": "ds", "label": "Environment", "query": "postgres", "regex": "/^dembrane/", "current": {"text": "dembrane prod", "value": "dembrane prod", "selected": true}, "hide": 0, "includeAll": false, "multi": false, "refresh": 1},
    {"type": "textbox", "name": "price_in_flash", "label": "EUR per 1M input tokens, flash", "query": "0.26", "current": {"text": "0.26", "value": "0.26", "selected": true}, "hide": 0},
    {"type": "textbox", "name": "price_out_flash", "label": "EUR per 1M output tokens, flash", "query": "2.10", "current": {"text": "2.10", "value": "2.10", "selected": true}, "hide": 0},
    {"type": "textbox", "name": "price_in_pro", "label": "EUR per 1M input tokens, pro", "query": "1.05", "current": {"text": "1.05", "value": "1.05", "selected": true}, "hide": 0},
    {"type": "textbox", "name": "price_out_pro", "label": "EUR per 1M output tokens, pro", "query": "8.40", "current": {"text": "8.40", "value": "8.40", "selected": true}, "hide": 0}
  ]},
  "panels": [
    {"id": 1, "type": "row", "title": "Today against yesterday (Amsterdam days)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {"id": 2, "type": "stat", "title": "Model calls", "description": "Every attempt at a model deployment that day: generate, stream and embed.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(calls), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(calls), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 3, "type": "stat", "title": "Input tokens", "description": "Prompt tokens sent that day, all calls. Audio counts as input tokens.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(input_tokens), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(input_tokens), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 4, "type": "stat", "title": "Output tokens", "description": "Tokens the models produced that day, thinking included where the vendor counts it.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(output_tokens), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(output_tokens), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 5, "type": "stat", "title": "Average context per call (tokens)", "description": "Input tokens divided by successful calls: how much context one request carries on average.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round(sum(input_tokens)::numeric / greatest(sum(calls - errors), 1)) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round(sum(input_tokens)::numeric / greatest(sum(calls - errors), 1)) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 6, "type": "stat", "title": "Largest request (tokens)", "description": "The biggest prompt of the day, in input tokens.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(max(max_input_tokens), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(max(max_input_tokens), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 7, "type": "stat", "title": "p95 latency (s)", "description": "95 % of successful model calls that day answered within this many seconds (a stream counts until its last token).", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round((percentile_cont(0.95) within group (order by ms) / 1000.0)::numeric, 1) as value from obs.model_calls where (started_at at time zone 'Europe/Amsterdam')::date = (now() at time zone 'Europe/Amsterdam')::date and status = 'ok'", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round((percentile_cont(0.95) within group (order by ms) / 1000.0)::numeric, 1) as value from obs.model_calls where (started_at at time zone 'Europe/Amsterdam')::date = ((now() at time zone 'Europe/Amsterdam')::date - 1) and status = 'ok'", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "decimals": 1}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 8, "type": "stat", "title": "Errors", "description": "Attempts that failed that day (rate limit, server error, timeout, bad request).", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 0, "y": 5}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(errors), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(errors), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 9, "type": "stat", "title": "Retries", "description": "Attempts after the first one on the same request that day.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 4, "y": 5}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(retries), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(retries), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 10, "type": "stat", "title": "Fallbacks", "description": "Calls answered by a later deployment in the group because the first ones failed.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 8, "y": 5}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(fallbacks), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(fallbacks), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 11, "type": "stat", "title": "Refusals", "description": "Answers the model refused: finish reason safety, recitation, blocklist or the like. Usually zero characters came back.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 12, "y": 5}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(refusals), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(refusals), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 12, "type": "stat", "title": "Truncated", "description": "Answers cut at the output token limit.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 16, "y": 5}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(truncated), 0) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select coalesce(sum(truncated), 0) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 13, "type": "stat", "title": "Estimated cost (EUR)", "description": "Estimate only: tokens times the prices in the dashboard variables (EUR per million tokens). The invoice is Vertex billing in the Google project; set the variables from it.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 4, "w": 4, "x": 20, "y": 5}, "targets": [{"refId": "today", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round(sum(input_tokens * (case when model like '%pro%' then ${price_in_pro} else ${price_in_flash} end) + output_tokens * (case when model like '%pro%' then ${price_out_pro} else ${price_out_flash} end))::numeric / 1000000, 2) as value from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date", "format": "table", "rawQuery": true, "editorMode": "code"}, {"refId": "yesterday", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select round(sum(input_tokens * (case when model like '%pro%' then ${price_in_pro} else ${price_in_flash} end) + output_tokens * (case when model like '%pro%' then ${price_out_pro} else ${price_out_flash} end))::numeric / 1000000, 2) as value from obs.day_model_calls where day = ((now() at time zone 'Europe/Amsterdam')::date - 1)", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "text": {"titleSize": 14, "valueSize": 26}}, "fieldConfig": {"defaults": {"unit": "currencyEUR", "color": {"mode": "fixed", "fixedColor": "text"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "decimals": 2}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "today"}, "properties": [{"id": "displayName", "value": "today"}]}, {"matcher": {"id": "byFrameRefID", "options": "yesterday"}, "properties": [{"id": "displayName", "value": "yesterday"}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8e8e8e"}}]}]}},
    {"id": 14, "type": "row", "title": "By feature, today", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}, "panels": []},
    {"id": 15, "type": "table", "title": "Model calls by operation and model, today", "description": "The operation is the job (conversations.chunk is transcription, conversations.summarize the summary, reports.generate the report) or the API route (chats, assistant) that made the call.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 9, "w": 24, "x": 0, "y": 10}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select operation, model_group as \"group\", model, sum(calls) as calls, sum(errors) as errors, sum(refusals) as refusals, sum(retries) as retries, sum(input_tokens) as input_tokens, sum(output_tokens) as output_tokens, round(sum(input_tokens)::numeric / greatest(sum(calls - errors), 1)) as avg_input, max(max_input_tokens) as max_input, max(p95_ms) as p95_ms from obs.day_model_calls where day = (now() at time zone 'Europe/Amsterdam')::date group by 1, 2, 3 order by calls desc", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}, "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": false}}, "overrides": [{"matcher": {"id": "byName", "options": "p95_ms"}, "properties": [{"id": "unit", "value": "ms"}]}, {"matcher": {"id": "byName", "options": "operation"}, "properties": [{"id": "custom.width", "value": 340}]}, {"matcher": {"id": "byName", "options": "model"}, "properties": [{"id": "custom.width", "value": 160}]}]}},
    {"id": 16, "type": "table", "title": "Largest requests, today", "description": "The twenty calls with the most input tokens today. No text, only sizes and times.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select started_at, operation, model, kind, input_tokens, output_tokens, ms, finish_reason, status from obs.model_calls where (started_at at time zone 'Europe/Amsterdam')::date = (now() at time zone 'Europe/Amsterdam')::date order by input_tokens desc nulls last limit 20", "format": "table", "rawQuery": true, "editorMode": "code"}], "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}, "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": false}}, "overrides": [{"matcher": {"id": "byName", "options": "ms"}, "properties": [{"id": "unit", "value": "ms"}]}, {"matcher": {"id": "byName", "options": "operation"}, "properties": [{"id": "custom.width", "value": 340}]}, {"matcher": {"id": "byName", "options": "started_at"}, "properties": [{"id": "custom.width", "value": 180}]}]}},
    {"id": 17, "type": "row", "title": "Over the selected time", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}, "panels": []},
    {"id": 18, "type": "timeseries", "title": "Model calls per 5 minutes, by operation", "description": "Attempts per bucket, by the job or route that made them. Reads the last 7 days.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 28}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), operation as metric, sum(calls) as value from obs.minute_model_calls where $__timeFilter(minute) group by 1, 2 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 19, "type": "timeseries", "title": "Errors per 5 minutes, by model", "description": "Failed attempts per bucket, by deployment.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 28}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), model as metric, sum(errors) as value from obs.minute_model_calls where $__timeFilter(minute) group by 1, 2 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 20, "type": "timeseries", "title": "Latency per 5 minutes (s): average and slowest, by group", "description": "Average and slowest call per bucket for each model group.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 35}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), model_group || ' avg' as metric, sum(avg_ms * calls)::double precision / greatest(sum(calls), 1) / 1000.0 as value from obs.minute_model_calls where $__timeFilter(minute) group by 1, 2 union all select $__timeGroupAlias(minute, 5m), model_group || ' max' as metric, max(max_ms) / 1000.0 as value from obs.minute_model_calls where $__timeFilter(minute) group by 1, 2 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 21, "type": "timeseries", "title": "Tokens per 5 minutes", "description": "Input and output tokens per bucket, all calls.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 35}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select $__timeGroupAlias(minute, 5m), sum(input_tokens) as input, sum(output_tokens) as output from obs.minute_model_calls where $__timeFilter(minute) group by 1 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
    {"id": 22, "type": "row", "title": "Last 35 days, one bar per day (own window, whatever the range above)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}, "panels": []},
    {"id": 23, "type": "timeseries", "title": "Tokens per day by model, last 35 days", "description": "Input plus output tokens, one bar per Amsterdam day, by deployment. This panel always shows the last 35 days.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 43}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select day as time, model as metric, sum(input_tokens + output_tokens) as value from obs.day_model_calls group by 1, 2 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}, "timeFrom": "35d", "hideTimeOverride": false},
    {"id": 24, "type": "timeseries", "title": "Calls, errors and refusals per day, last 35 days", "description": "One bar per Amsterdam day, all operations. This panel always shows the last 35 days.", "datasource": {"type": "postgres", "uid": "${ds}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 43}, "targets": [{"refId": "A", "datasource": {"type": "postgres", "uid": "${ds}"}, "rawSql": "select day as time, sum(calls) as calls, sum(errors) as errors, sum(refusals) as refusals from obs.day_model_calls group by 1 order by 1", "format": "time_series", "rawQuery": true, "editorMode": "code"}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}, "timeFrom": "35d", "hideTimeOverride": false},
