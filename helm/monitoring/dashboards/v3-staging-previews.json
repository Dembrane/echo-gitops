    {"id": 28, "type": "stat", "title": "Estimated cost (EUR)", "description": "Estimate only: the tokens times the prices in the dashboard variables (EUR per million tokens), the flash prices for every model. The invoice is Vertex billing in the Google project.", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "gridPos": {"h": 4, "w": 5, "x": 19, "y": 59}, "targets": [{"refId": "A", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "queryType": "timeSeriesList", "aliasBy": "input", "timeSeriesList": {"projectName": "$project", "filters": ["metric.type", "=", "aiplatform.googleapis.com/publisher/online_serving/token_count", "AND", "metric.label.type", "=", "input"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "cloud-monitoring-auto", "groupBys": [], "view": "FULL", "preprocessor": "none"}, "hide": true}, {"refId": "B", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "queryType": "timeSeriesList", "aliasBy": "output", "timeSeriesList": {"projectName": "$project", "filters": ["metric.type", "=", "aiplatform.googleapis.com/publisher/online_serving/token_count", "AND", "metric.label.type", "=", "output"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "cloud-monitoring-auto", "groupBys": [], "view": "FULL", "preprocessor": "none"}, "hide": true}, {"refId": "C", "datasource": {"type": "__expr__", "uid": "__expr__"}, "type": "reduce", "expression": "A", "reducer": "sum", "settings": {"mode": "dropNN"}, "hide": true}, {"refId": "D", "datasource": {"type": "__expr__", "uid": "__expr__"}, "type": "reduce", "expression": "B", "reducer": "sum", "settings": {"mode": "dropNN"}, "hide": true}, {"refId": "E", "datasource": {"type": "__expr__", "uid": "__expr__"}, "type": "math", "expression": "($C * ${price_in_flash} + $D * ${price_out_flash}) / 1000000"}], "options": {"reduceOptions": {"values": false, "calcs": ["sum"], "fields": ""}, "orientation": "auto", "