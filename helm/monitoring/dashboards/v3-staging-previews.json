    {"id": 4, "type": "stat", "title": "Share of 5xx", "description": "Server errors as a share of all responses of the picked services, over the selected time. 0 when there was no 5xx.", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "gridPos": {"h": 8, "w": 4, "x": 0, "y": 9}, "targets": [{"refId": "A", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "queryType": "timeSeriesList", "aliasBy": "5xx", "timeSeriesList": {"projectName": "$project", "filters": ["metric.type", "=", "run.googleapis.com/request_count", "AND", "resource.label.service_name", "=~", "$service", "AND", "metric.label.response_code_class", "=", "5xx"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "+300s", "groupBys": [], "view": "FULL", "preprocessor": "none"}, "hide": true}, {"refId": "B", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "queryType": "timeSeriesList", "aliasBy": "all", "timeSeriesList": {"projectName": "$project", "filters": ["metric.type", "=", "run.googleapis.com/request_count", "AND", "resource.label.service_name", "=~", "$service"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "+300s", "groupBys": [], "view": "FULL", "preprocessor": "none"}, "hide": true}, {"refId": "C", "datasource": {"type": "__expr__", "uid": "__expr__"}, "type": "reduce", "expression": "A", "reducer": "sum", "settings": {"mode": "dropNN"}, "hide": true}, {"refId": "D", "datasource": {"type": "__expr__", "uid": "__expr__"}, "type": "reduce", "expression": "B", "reducer": "sum", "settings": {"mode": "dropNN"}, "hide": true}, {"refId": "E", "datasource": {"type": "__expr__", "uid": "__expr__"}, "type": "math", "expression": "$C / $D * 100"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "orientation": "auto"}, "fieldConfig": {"defaults": {"unit": "percent"