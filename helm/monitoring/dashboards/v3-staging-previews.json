    {"id": 19, "type": "timeseries", "title": "Jobs waiting, by worker and queue", "description": "Jobs ready to run and not started, as the worker reports them each minute (average per point). The list puts the fullest queue first. A line that stays above zero is a queue that does not drain.", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34}, "targets": [{"refId": "A", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "queryType": "timeSeriesList", "aliasBy": "{{resource.label.worker_pool_name}} {{metric.label.queue}}", "timeSeriesList": {"projectName": "$project", "filters": ["metric.type", "=", "logging.googleapis.com/user/${stack}/queue_ready"], "crossSeriesReducer": "REDUCE_MEAN", "perSeriesAligner": "ALIGN_DELTA", "alignmentPeriod": "cloud-monitoring-auto", "groupBys": ["resource.label.worker_pool_name", "metric.label.queue"], "view": "FULL", "preprocessor": "none"}}], "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max"], "sortBy": "Max", "sortDesc": true, "width": 330}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "pointSize": 4, "showPoints": "auto", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}, "min": 0}, "overrides": []}},
