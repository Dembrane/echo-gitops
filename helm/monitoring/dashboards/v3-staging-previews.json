    {"id": 5, "type": "timeseries", "title": "5xx per second by service", "description": "Server errors by service. Empty means none.", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "gridPos": {"h": 8, "w": 8, "x": 4, "y": 9}, "targets": [{"refId": "A", "datasource": {"type": "stackdriver", "uid": "gcm-${env}"}, "queryType": "timeSeriesList", "aliasBy": "{{resource.label.service_name}}", "timeSeriesList": {"projectName": "$project", "filters": ["metric.type", "=", "run.googleapis.com/request_count", "AND", "resource.label.service_name", "=~", "$service", "AND", "metric.label.response_code_class", "=", "5xx"], "crossSeriesReducer": "REDUCE_SUM", "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "cloud-monitoring-auto", "groupBys": ["resource.label.service_name"], "view": "FULL", "preprocessor": "none"}}], "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "pointSize": 4, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "axisPlacement": "auto"}}, "overrides": []}},
