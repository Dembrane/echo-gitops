    {"id": 23, "type": "timeseries", "title": "Worker CPU", "description": "CPU each worker pod uses, one line per pod, against the request and the limit of one pod.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 56}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", pod=~\"dembrane-web-worker-.*\"}[$__rate_interval]))", "editorMode": "code", "legendFormat": "{{pod}}", "range": true}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_pod_container_resource_requests{namespace=\"$namespace\", resource=\"cpu\", pod=~\"dembrane-web-worker-.*\"})", "editorMode": "code", "legendFormat": "request", "range": true}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"cpu\", pod=~\"dembrane-web-worker-.*\"})", "editorMode": "code", "legendFormat": "limit", "range": true}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "cores", "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "off"}}, "color": {"mode": "fixed", "fixedColor": "#d95926"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0}, "overrides": [{"matcher": {"id": "byName", "options": "request"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}, {"id": "custom.lineWidth", "value": 1}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}, {"id": "custom.fillOpacity", "value": 0}, {"id": "custom.stacking", "value": {"mode": "none", "group": "A"}}]}, {"matcher": {"id": "byName", "options": "limit"}