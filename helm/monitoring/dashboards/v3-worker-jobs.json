  "templating": {"list": [{"type": "query", "name": "namespace", "label": "Namespace", "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "query_result(sort_desc(3 * group by (namespace) (kube_pod_info{namespace=\"__NAMESPACE__\"}) or 2 * group by (namespace) (kube_pod_info{namespace=~\"dembrane-web-.*\"}) or label_replace(vector(1), \"namespace\", \"__NAMESPACE__\", \"\", \"\")))", "query": {"query": "query_result(sort_desc(3 * group by (namespace) (kube_pod_info{namespace=\"__NAMESPACE__\"}) or 2 * group by (namespace) (kube_pod_info{namespace=~\"dembrane-web-.*\"}) or label_replace(vector(1), \"namespace\", \"__NAMESPACE__\", \"\", \"\")))", "refId": "StandardVariableQuery"}, "regex": "/namespace=\"([^\"]+)\"/", "refresh": 1, "sort": 0, "multi": false, "includeAll": false, "hide": 0, "skipUrlSync": false, "options": []}]},
  "panels": [
    {"id": 1, "type": "row", "title": "Queues", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {"id": 2, "type": "stat", "title": "Waiting", "description": "Jobs ready to run and not yet picked up, over all queues.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 3, "x": 0, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (last_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"ready\" | unwrap v [3m])))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 0}, "overrides": []}},
    {"id": 3, "type": "stat", "title": "Running", "description": "Jobs a worker is running now, over all queues.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 3, "x": 3, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (last_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"active\" | unwrap v [3m])))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 0}, "overrides": []}},
    {"id": 4, "type": "stat", "title": "Failed (24 h)", "description": "Jobs that ended in an error in the last 24 hours, over all queues.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 3, "x": 6, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (last_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"failed\" | unwrap v [3m])))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 0}, "overrides": []}},
    {"id": 5, "type": "stat", "title": "Deferred", "description": "Jobs scheduled to run later, over all queues.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 3, "x": 9, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (last_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"deferred\" | unwrap v [3m])))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 0}, "overrides": []}},
    {"id": 6, "type": "stat", "title": "Oldest waiting job", "description": "How long the oldest job that is ready has waited. None when nothing waits.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 4, "x": 12, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max(last_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json v=\"oldestReadyS\" | unwrap v | __error__=\"\" [3m]))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "unit": "s", "noValue": "none"}, "overrides": []}},
    {"id": 7, "type": "stat", "title": "Queues reporting", "description": "Queues the worker reported on in the last 3 minutes. 0 means no worker writes queue health.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 4, "x": 16, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "count(max by (name) (last_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"ready\" | unwrap v [3m])))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 0, "noValue": "0"}, "overrides": []}},
    {"id": 8, "type": "stat", "title": "Heartbeats (5 min)", "description": "A scheduled job runs every minute and logs a heartbeat, so about 5 is normal. 0 means schedules are not firing.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 3, "w": 4, "x": 20, "y": 1}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(count_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"worker.heartbeat\\\"\" [5m]))", "editorMode": "code", "queryType": "instant"}], "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "none", "graphMode": "none", "justifyMode": "center"}, "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 0, "noValue": "0"}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "Jobs waiting, by queue", "description": "Jobs ready to run, per queue. Only queues with jobs waiting get a line; the dashed line is all queues together.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 6, "w": 12, "x": 0, "y": 4}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"ready\" | unwrap v [2m])) > 0", "editorMode": "code", "queryType": "range", "legendFormat": "{{name}}"}, {"refId": "B", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"ready\" | unwrap v [2m])))", "editorMode": "code", "queryType": "range", "legendFormat": "all queues"}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "jobs", "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "off"}, "axisSoftMax": 5}, "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0, "decimals": 0}, "overrides": [{"matcher": {"id": "byName", "options": "all queues"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}, {"id": "custom.lineWidth", "value": 1}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}, {"id": "custom.fillOpacity", "value": 0}, {"id": "custom.stacking", "value": {"mode": "none", "group": "A"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"], "width": 280, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "interval": "1m"},
    {"id": 10, "type": "timeseries", "title": "Jobs running, by queue", "description": "Jobs being run, per queue. Only queues with running jobs get a line; the dashed line is all queues together.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 6, "w": 12, "x": 12, "y": 4}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"active\" | unwrap v [2m])) > 0", "editorMode": "code", "queryType": "range", "legendFormat": "{{name}}"}, {"refId": "B", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"active\" | unwrap v [2m])))", "editorMode": "code", "queryType": "range", "legendFormat": "all queues"}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "jobs", "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "off"}, "axisSoftMax": 5}, "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0, "decimals": 0}, "overrides": [{"matcher": {"id": "byName", "options": "all queues"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}, {"id": "custom.lineWidth", "value": 1}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}, {"id": "custom.fillOpacity", "value": 0}, {"id": "custom.stacking", "value": {"mode": "none", "group": "A"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"], "width": 280, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "interval": "1m"},
    {"id": 11, "type": "timeseries", "title": "Jobs failed in the last 24 h, by queue", "description": "Jobs that ended in an error in the 24 hours before each point, per queue. Only queues with failed jobs get a line.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 6, "w": 12, "x": 0, "y": 10}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"failed\" | unwrap v [2m])) > 0", "editorMode": "code", "queryType": "range", "legendFormat": "{{name}}"}, {"refId": "B", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"failed\" | unwrap v [2m])))", "editorMode": "code", "queryType": "range", "legendFormat": "all queues"}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "jobs", "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "off"}, "axisSoftMax": 5}, "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0, "decimals": 0}, "overrides": [{"matcher": {"id": "byName", "options": "all queues"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}, {"id": "custom.lineWidth", "value": 1}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}, {"id": "custom.fillOpacity", "value": 0}, {"id": "custom.stacking", "value": {"mode": "none", "group": "A"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"], "width": 280, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "interval": "1m"},
    {"id": 12, "type": "timeseries", "title": "Jobs deferred, by queue", "description": "Jobs scheduled to run later, per queue. Only queues with deferred jobs get a line.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 6, "w": 12, "x": 12, "y": 10}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"deferred\" | unwrap v [2m])) > 0", "editorMode": "code", "queryType": "range", "legendFormat": "{{name}}"}, {"refId": "B", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum(max by (name) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"signal\\\":\\\"queue.depth\\\"\" | json name=\"name\", v=\"deferred\" | unwrap v [2m])))", "editorMode": "code", "queryType": "range", "legendFormat": "all queues"}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "jobs", "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "off"}, "axisSoftMax": 5}, "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0, "decimals": 0}, "overrides": [{"matcher": {"id": "byName", "options": "all queues"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}, {"id": "custom.lineWidth", "value": 1}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}, {"id": "custom.fillOpacity", "value": 0}, {"id": "custom.stacking", "value": {"mode": "none", "group": "A"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"], "width": 280, "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "interval": "1m"},
    {"id": 13, "type": "row", "title": "Jobs", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16}, "panels": []},
    {"id": 14, "type": "timeseries", "title": "Jobs finished per minute, by area", "description": "Jobs the worker finished per minute (5 minute average): billing, reports, conversations, and everything else as other.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 17}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (area) (rate({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job done\\\"\" | json job=\"job\" | label_format area=`{{ if hasPrefix \"billing.\" .job }}billing{{ else if hasPrefix \"reports.\" .job }}reports{{ else if hasPrefix \"conversations.\" .job }}conversations{{ else }}other{{ end }}` [5m])) * 60", "editorMode": "code", "queryType": "range", "legendFormat": "{{area}}"}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "jobs per minute", "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "off"}}, "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0}, "overrides": [{"matcher": {"id": "byName", "options": "billing"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#3987e5"}}]}, {"matcher": {"id": "byName", "options": "reports"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#d95926"}}]}, {"matcher": {"id": "byName", "options": "conversations"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#199e70"}}]}, {"matcher": {"id": "byName", "options": "other"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}]}]}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}, "interval": "1m"},
    {"id": 15, "type": "timeseries", "title": "Failed job attempts per 5 min, by job", "description": "Attempts that threw an error, per job. A failed attempt is retried. No data means none failed.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 17}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (job) (count_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job failed\\\"\" | json job=\"job\" [$__interval]))", "editorMode": "code", "queryType": "range", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "pointSize": 5, "spanNulls": false, "lineInterpolation": "linear", "axisLabel": "attempts per 5 min", "axisPlacement": "auto", "stacking": {"mode": "normal", "group": "A"}, "thresholdsStyle": {"mode": "off"}, "barAlignment": 0}, "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "min": 0, "decimals": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"], "sortBy": "Total", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "interval": "5m"},
    {"id": 16, "type": "table", "title": "Billing, report and conversation jobs in the selected period", "description": "Each billing, report and conversation job that ran in the selected period, scheduled jobs included: Runs is how often it finished, Failed how many attempts threw an error, Slowest its longest run, Last run when it last finished.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 13, "w": 12, "x": 0, "y": 24}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (job) (count_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job done\\\"\" | json job=\"job\" | job=~\"(billing|reports|conversations)\\\\..+\" [$__range]))", "editorMode": "code", "queryType": "instant"}, {"refId": "B", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (job) (count_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job failed\\\"\" | json job=\"job\" | job=~\"(billing|reports|conversations)\\\\..+\" [$__range])) or sum by (job) (count_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job done\\\"\" | json job=\"job\" | job=~\"(billing|reports|conversations)\\\\..+\" [$__range])) * 0", "editorMode": "code", "queryType": "instant"}, {"refId": "C", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max by (job) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job done\\\"\" | json job=\"job\", ms=\"ms\" | job=~\"(billing|reports|conversations)\\\\..+\" | unwrap ms [$__range]))", "editorMode": "code", "queryType": "instant"}, {"refId": "D", "datasource": {"type": "loki", "uid": "loki"}, "expr": "max by (job) (max_over_time({namespace=\"$namespace\", component=\"worker\"} |= \"\\\"message\\\":\\\"job done\\\"\" | json job=\"job\" | job=~\"(billing|reports|conversations)\\\\..+\" | label_format ts=`{{ __timestamp__ | unixEpoch }}` | unwrap ts [$__range])) * 1000", "editorMode": "code", "queryType": "instant"}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"job": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4}, "renameByName": {"job": "Job", "Value #A": "Runs", "Value #B": "Failed", "Value #C": "Slowest", "Value #D": "Last run"}}}, {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "Job"}]}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "minWidth": 50}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "color": {"mode": "thresholds"}, "noValue": "-"}, "overrides": [{"matcher": {"id": "byName", "options": "Runs"}, "properties": [{"id": "decimals", "value": 0}, {"id": "custom.width", "value": 66}]}, {"matcher": {"id": "byName", "options": "Failed"}, "properties": [{"id": "decimals", "value": 0}, {"id": "custom.width", "value": 76}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "#d03b3b", "value": 1}]}}]}, {"matcher": {"id": "byName", "options": "Slowest"}, "properties": [{"id": "unit", "value": "ms"}, {"id": "custom.width", "value": 92}]}, {"matcher": {"id": "byName", "options": "Last run"}, "properties": [{"id": "unit", "value": "dateTimeFromNow"}, {"id": "custom.width", "value": 160}]}]}, "options": {"showHeader": true, "footer": {"show": false, "reducer": ["sum"], "countRows": false, "fields": ""}}},
