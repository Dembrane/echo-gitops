    {"id": 21, "type": "logs", "title": "Error and warning lines", "description": "The lines counted above, newest first, shortened to severity, service, message and error. Open a line for every field. Plain text a service wrote to stderr, such as a crash trace, is listed too.", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"h": 11, "w": 24, "x": 0, "y": 44}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{namespace=\"$namespace\"} |~ \"\\\"severity\\\":\\\"(WARNING|ERROR|CRITICAL)\\\"\" | json | line_format `{{ if .message }}{{ .severity }}  {{ .service }}  {{ .message }}{{ if .job }}  job={{ .job }}{{ end }}{{ if .route }}  {{ .route }}{{ end }}{{ if .err }}  {{ .err }}{{ end }}{{ if .err_message }}  {{ .err_message }}{{ end }}{{ if .detail }}  {{ .detail }}{{ end }}{{ else }}{{ __line__ }}{{ end }}`", "editorMode": "code", "queryType": "range"}, {"refId": "B", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{namespace=\"$namespace\", stream=\"stderr\"} !~ \"^\\\\{\"", "editorMode": "code", "queryType": "range"}], "options": {"showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none", "showLabels": false, "showCommonLabels": false, "prettifyLogMessage": false}},
